# Copier en /opt/sillygames/.env sur la VM. Jamais commité.
DOMAIN=sillygames.duckdns.org
GHCR_OWNER=polc4
# Tag d'image déployé ; le workflow de déploiement le remplace par sha-<commit>.
IMAGE_TAG=latest
# openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32
JWT_SECRET=

# Connexion externe (étape 2 bis). URL de retour à déclarer chez chaque fournisseur :
# https://<DOMAIN>/api/auth/oauth/<github|google|microsoft|facebook>/callback
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_FACEBOOK_CLIENT_ID=
OAUTH_FACEBOOK_CLIENT_SECRET=
