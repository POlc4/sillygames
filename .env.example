# Copier en .env (jamais commité). Valeurs de développement uniquement.
POSTGRES_USER=sillygames
POSTGRES_PASSWORD=sillygames
POSTGRES_DB=sillygames

# Depuis l'hôte : localhost. Depuis le devcontainer, DATABASE_URL est surchargé vers "postgres".
DATABASE_URL=postgresql+psycopg://sillygames:sillygames@localhost:5432/sillygames

# Générer une vraie valeur en prod : openssl rand -hex 32
JWT_SECRET=dev-only-change-me-dev-only-change-me-000

# Connexion externe en dev (URL de retour : http://localhost:3000/api/auth/oauth/<provider>/callback).
# Laisser vide pour masquer le bouton du fournisseur.
PUBLIC_URL=http://localhost:3000
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
